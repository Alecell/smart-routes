{
  "name": "smart-routes",
  "version": "2.1.0",
  "description": "A framework agnostic, strongly-typed way to centralize and reuse routes on web apps.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "routing",
    "routes",
    "router",
    "typescript",
    "type-safe",
    "react",
    "vue",
    "angular"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Alecell/smart-routes"
  },
  "author": "Alecell",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
